rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isCapster() {
      return signedIn() && request.auth.token.role == 'capster';
    }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function ownsCustomerRecord() {
      return signedIn() && resource.data.customerUid == request.auth.uid;
    }

    // Data konfigurasi yang boleh tampil di halaman pelanggan.
    match /config/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /queueSessions/{session} {
      allow read: if true;
      allow write: if false;
    }
    match /queuePublic/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /bookingPublic/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /schedules/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /promos/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /capsterProfile/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Profil pribadi hanya dapat dibaca oleh pemilik. Semua mutasi melewati API Admin.
    match /customers/{uid} {
      allow read: if owns(uid);
      allow write: if false;
    }
    match /queuePrivate/{document} {
      allow read: if isCapster() || ownsCustomerRecord();
      allow write: if false;
    }
    match /bookingPrivate/{document} {
      allow read: if isCapster() || ownsCustomerRecord();
      allow write: if false;
    }

    // Koleksi internal. Hanya server Firebase Admin yang boleh mengaksesnya.
    match /waAccounts/{document} { allow read, write: if false; }
    match /activeQueues/{document} { allow read, write: if false; }
    match /bookingCounters/{document} { allow read, write: if false; }
    match /bookingSlots/{document} { allow read, write: if false; }
    match /capsterSessions/{document} { allow read, write: if false; }
    match /sheetSyncQueue/{document} { allow read, write: if false; }
    match /sheetSyncLocks/{document} { allow read, write: if false; }
  }
}
