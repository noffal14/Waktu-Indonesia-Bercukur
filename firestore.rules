rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isCapster() {
      return signedIn() && request.auth.token.role == 'capster';
    }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    match /config/{document} {
      allow read: if true;
      allow write: if isCapster();
    }
    match /queueSessions/{session} {
      allow read: if true;
      allow write: if isCapster();
    }
    match /queuePublic/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /bookingPublic/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /schedules/{document} {
      allow read: if true;
      allow write: if isCapster();
    }
    match /promos/{document} {
      allow read: if true;
      allow write: if isCapster();
    }
    match /capsterProfile/{document} {
      allow read: if true;
      allow write: if isCapster();
    }
    match /customers/{uid} {
      allow read, create, update: if owns(uid);
      allow delete: if owns(uid);
    }
    match /queuePrivate/{document} {
      allow read: if isCapster();
      allow write: if false;
    }
    match /bookingPrivate/{document} {
      allow read: if isCapster();
      allow write: if false;
    }
    match /capsterSessions/{document} {
      allow read, write: if false;
    }
  }
}
